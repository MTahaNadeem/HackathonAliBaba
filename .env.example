# Supabase Free project: Settings > API. This is a publishable/anon key, NOT service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Gemini: use a free-tier project WITHOUT Cloud Billing enabled.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional only for the trusted seed script, never for application requests.
SUPABASE_SERVICE_ROLE_KEY=
