# Supabase Free project: Settings > API. This is a publishable/anon key, NOT service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Gemini: use a free-tier project WITHOUT Cloud Billing enabled.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Required for the seed script AND the weekly ingestion pipeline. Never prefix with NEXT_PUBLIC_.
# Remove from .env.local after seeding in development; use Vercel env vars in production.
SUPABASE_SERVICE_ROLE_KEY=
# Random secret used to authenticate the Vercel Cron endpoint /api/ingestion/refresh.
# Set a long random string (e.g. openssl rand -hex 32). Configure the same value in Vercel.
CRON_SECRET=
