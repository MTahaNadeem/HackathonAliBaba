{
  "manifest_version": 3,
  "name": "CourseAI Compass – Job Analyzer",
  "version": "1.0.0",
  "description": "Instantly analyze any job listing against your skills. Understand your skill alignment before you apply.",
  "author": "CourseAI Compass",

  "action": {
    "default_popup": "popup.html",
    "default_title": "CourseAI Compass – Job Analyzer"
  },

  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "background": {
    "service_worker": "background.js"
  }
}
