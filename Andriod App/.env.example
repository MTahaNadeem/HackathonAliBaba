# =============================================================================
# DustZero — Environment Variables
# =============================================================================
#
# SETUP INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Fill in your real values in .env
#   3. NEVER commit .env to Git — it is in .gitignore
#
# HOW IT WORKS:
#   The Secrets Gradle Plugin reads .env and injects these as BuildConfig
#   fields at compile time. Access them in code via BuildConfig.SUPABASE_URL
#
# =============================================================================

# ─── Supabase ─────────────────────────────────────────────────────────────────
#
# Get these from: https://supabase.com → Your Project → Settings → API
#
# SUPABASE_URL: Your project URL (e.g. https://abcdefg.supabase.co)
# SUPABASE_KEY: The "anon" public key — safe to use in the mobile app
#               DO NOT use the "service_role" key here — it is not safe for clients
#
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_KEY=eyJhb...

# ─── Device ───────────────────────────────────────────────────────────────────
#
# The device_id must match the value in your Supabase "devices" table.
# The default is defined in AppConstants.kt: DEVICE_ID = "dustzero-001"
# Update AppConstants.kt if you change the device ID.
#
# DEVICE_ID=dustzero-001

# ─── Optional: Gemini API ──────────────────────────────────────────────────────
#
# Only needed if AI features are enabled. Leave commented out otherwise.
#
# GEMINI_API_KEY=MY_GEMINI_API_KEY